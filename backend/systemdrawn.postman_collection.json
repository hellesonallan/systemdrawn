{
  "info": {
    "name": "SystemDrawn API",
    "_postman_id": "c0f3c3e4-1234-5678-90ab-systemdrawn",
    "description": "Collection para testar todos os endpoints da API de agendamento de tatuagem e piercing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "cpf",
      "value": "12345678901"
    },
    {
      "key": "agendamentoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Usuários",
      "item": [
        {
          "name": "Criar Usuário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"{{cpf}}\",\n  \"nome\": \"João Silva\",\n  \"telefone\": \"81999999999\",\n  \"email\": \"joao@email.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios"]
            }
          }
        },
        {
          "name": "Buscar Usuário",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{cpf}}",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios", "{{cpf}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Agendamentos",
      "item": [
        {
          "name": "Criar Agendamento",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('agendamentoId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioCpf\": \"{{cpf}}\",\n  \"tipo\": \"TATUAGEM\",\n  \"data\": \"2026-06-20\",\n  \"horario\": \"14:00\",\n  \"observacao\": \"Tatuagem no antebraço\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/agendamentos",
              "host": ["{{baseUrl}}"],
              "path": ["agendamentos"]
            }
          }
        },
        {
          "name": "Listar Agendamentos por CPF",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/agendamentos/usuario/{{cpf}}",
              "host": ["{{baseUrl}}"],
              "path": ["agendamentos", "usuario", "{{cpf}}"]
            }
          }
        },
        {
          "name": "Atualizar Agendamento",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": \"2026-06-21\",\n  \"horario\": \"15:00\",\n  \"observacao\": \"Horário alterado\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/agendamentos/{{agendamentoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["agendamentos", "{{agendamentoId}}"]
            }
          }
        },
        {
          "name": "Excluir Agendamento",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/agendamentos/{{agendamentoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["agendamentos", "{{agendamentoId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    }
  ]
}
